# =============================================================
# InzuHub Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# PostgreSQL connection string
# Local dev:   postgresql://inzuhub:devpassword@localhost:5432/inzuhub_dev?sslmode=disable
# Production:  postgresql://user:password@host:5432/inzuhub?sslmode=require
DATABASE_URL=postgresql://inzuhub:devpassword@localhost:5432/inzuhub_dev?sslmode=disable

# HTTP server port (default: 8080)
PORT=8080

# Environment: development | production
APP_ENV=development

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://inzu-hub.vercel.app

# Groq AI API (same credentials used by the Next.js frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# JWT secret for signing API tokens (generate with: openssl rand -base64 32)
# Must match frontend BACKEND_JWT_SECRET.
JWT_SECRET=

# Payment providers — server-only; never expose these in frontend env vars.
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_SUBSCRIPTION_KEY=

AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

PAYMENT_PSP_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Used by seed script to prevent accidental production truncation
# Set to "production" in your hosting environment
APP_ENV=development
