# ============================================================
# InzuHub — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# Backend API (server-only; never exposed to the browser)
# Use the local URL for development. Set this to the Render service URL in Vercel.
BACKEND_API_URL=http://localhost:8080

# Must match backend JWT_SECRET. Server-only; never expose to the browser.
BACKEND_JWT_SECRET=

# ── AI (Groq) — Phase 0 ─────────────────────────────────────
# Required for the AI concierge and conversational search.
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model (confirmed available on your account)
# Run GET https://api.groq.com/openai/v1/models to list available models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: faster model used for search filter extraction
GROQ_MODEL_FAST=openai/gpt-oss-20b

# ── Authentication — Phase 2 ────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
# AUTH_SECRET=your_nextauth_secret_here

# NextAuth URL (set to your domain in production)
# NEXTAUTH_URL=http://localhost:3000

# Google OAuth — add http://localhost:3000/api/auth/callback/google and your
# production callback URL to the OAuth client’s authorized redirect URIs.
# AUTH_GOOGLE_ID=your_google_client_id
# AUTH_GOOGLE_SECRET=your_google_client_secret

# Development demo credentials only. Never set these in production.
# The shared demo password is: InzuHub@123
DEMO_AUTH_ENABLED=true
DEMO_PASSWORD_HASH=$2b$12$VH9.SfdOCB/yICbH/MmN2OohsBNJkQWrLLW84tiywAsSnMaaxkBdi

# ── Google Maps — Phase 3 ───────────────────────────────────
# Restrict this key to your domain in the Google Cloud Console
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ── File Storage — Phase 3 ──────────────────────────────────
# Vercel Blob or Cloudflare R2 for property image uploads
# BLOB_READ_WRITE_TOKEN=your_blob_token_here

# ── Email — Phase 2 ─────────────────────────────────────────
# Resend for transactional email (viewing confirmations, OTPs)
# RESEND_API_KEY=your_resend_api_key_here
